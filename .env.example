# Backend configuration
TELEMETRY_INTERVAL=1
SIMULATION_SPEED=1
API_PORT=8000
ENGINE_ID=APT-MALE-SIM-01
DATABASE_URL=sqlite:///backend/data/aerotwin.db

# Optional model-powered assistant. Leave blank for local evidence summaries.
# Keep this key in the backend environment; never put it in frontend/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional frontend override when the API is not proxied through Vite
# VITE_API_URL=http://localhost:8000
